<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    android:focusable="true"
    android:clickable="true"
    android:padding="1dp">

    <!-- Live RTSP video (optional). Kept underneath the snapshot, which is hidden once
         the first video frame is rendered and shown again whenever the stream fails.
         TextureView so it composes correctly with the overlays and the other tiles.
         Video and snapshot are stretched to fill the tile: the DVR sub stream is 704x480
         (anamorphic 16:9), so filling is closer to the real proportions than letterboxing. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:visibility="gone"
        app:use_controller="false"
        app:resize_mode="fill"
        app:surface_type="texture_view"
        app:shutter_background_color="#111111" />

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111111"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:background="#88000000"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <View
        android:id="@+id/focusBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cell_focus"
        android:visibility="invisible" />
</FrameLayout>
